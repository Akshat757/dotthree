[
  {
    "name": "Homepage initial JS",
    "path": "out/_next/static/chunks/app/page-*.js",
    "limit": "170 KB",
    "gzip": true
  },
  {
    "name": "Shared framework + app chunks",
    "path": ["out/_next/static/chunks/main-app-*.js", "out/_next/static/chunks/framework-*.js"],
    "limit": "170 KB",
    "gzip": true
  },
  {
    "name": "Visualiser route JS",
    "path": "out/_next/static/chunks/app/visualiser/**/*.js",
    "limit": "300 KB",
    "gzip": true
  }
]
