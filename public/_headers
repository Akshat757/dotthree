# Cloudflare Pages headers — SRS §12 security baseline.
# Only third-party origin permitted: OpenStreetMap tiles (behind a click-to-load facade).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self' blob: https://cloudflareinsights.com https://script.google.com https://script.googleusercontent.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com; frame-ancestors 'none'; upgrade-insecure-requests

# Shared designs are private-by-URL — never indexed.
/d/*
  X-Robots-Tag: noindex, nofollow
/b/*
  X-Robots-Tag: noindex, nofollow
/dev/*
  X-Robots-Tag: noindex, nofollow

# Immutable hashed build assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated derivatives are content-addressed by filename suffix; safe to cache long.
/demo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/textures/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
