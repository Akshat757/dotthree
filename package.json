{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-cost premium interior design website & design platform — Indore",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "assets:images": "tsx scripts/fetch-demo-assets.ts",
    "assets:shades": "tsx scripts/generate-shades.ts",
    "assets:textures": "tsx scripts/fetch-textures.ts",
    "assets:templates": "tsx scripts/author-templates.ts",
    "assets:og": "tsx scripts/generate-og.ts",
    "assets:icons": "tsx scripts/generate-icons.ts",
    "assets:verify": "tsx scripts/verify-assets.ts",
    "assets:all": "npm run assets:shades && npm run assets:images && npm run assets:textures && npm run assets:templates && npm run assets:icons && npm run assets:og",
    "check:contacts": "tsx scripts/check-hardcoded-contacts.ts",
    "check:licenses": "license-checker --production --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense;MPL-2.0;Python-2.0;BlueOak-1.0.0;CC-BY-4.0;CC-BY-3.0;OFL-1.1\" --excludePrivatePackages",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-pdf/renderer": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "fflate": "^0.8.2",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "isomorphic-dompurify": "^2.25.0",
    "konva": "^9.3.20",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "minisearch": "^7.1.2",
    "motion": "^12.23.0",
    "next": "^15.4.0",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-konva": "^19.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.31.0",
    "@hookform/resolvers": "^5.1.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.54.0",
    "@size-limit/file": "^11.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/culori": "^4.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "blurhash": "^2.0.5",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "satori": "^0.15.2",
    "serve": "^14.2.4",
    "sharp": "^0.34.3",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
