# The app runs completely with this file empty. Nothing here is required. (SRS §16.1)

# Canonical site URL — defaults to the deploy URL
NEXT_PUBLIC_SITE_URL=

# Cloudflare Web Analytics — free, unlimited, no card. Optional.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare Turnstile site key — free, optional; honeypot + time-trap used if absent
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Apps Script Web App URL that appends leads to a Google Sheet — free, optional.
# See docs/LEAD-SINK-SETUP.md. Public by design (it is a write-only endpoint you control).
NEXT_PUBLIC_LEAD_SHEETS_WEBAPP_URL=

# Free form relay (Web3Forms / Formspree) — optional
NEXT_PUBLIC_LEAD_FORM_RELAY_ENDPOINT=
NEXT_PUBLIC_LEAD_FORM_RELAY_KEY=

# Runtime modes — 'demo' | 'db', 'local' | 'google'. Leave empty for Demo Mode.
NEXT_PUBLIC_DATA_MODE=
NEXT_PUBLIC_AUTH_MODE=

# DB Mode only (not built in Phase 0–2)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
SENTRY_DSN=
